{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "xiaoniaoshuo-admin",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiaoniaoshuo-db",
      "database_id": "58b80611-f382-4e20-b110-cd50dac2f624"
    },
    {
      // OpenNext D1 tag cache，revalidatePath 按需失效用；deploy 时自动建 revalidations 表
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "xiaoniaoshuo-db",
      "database_id": "58b80611-f382-4e20-b110-cd50dac2f624"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "9bf5ab2aa257483f9d82800297591bb8",
      "preview_id": "9bf5ab2aa257483f9d82800297591bb8"
    }
  ],
  // observability 已关闭：Workers Logs 额度不足，打开 persist/head 采样会持续烧额度。
  // 需要排障时再临时打开，平时保持关闭。
  "observability": {
    "enabled": false
  },
  "placement": {
    "mode": "smart"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "site-cache"
    },
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "xiaoniaoshuo"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "xiaoniaoshuo-admin"
    }
  ],
  "vars": {
    "ASSETS_PUBLIC_DOMAIN": "https://i.xiaoniaoshuo.com",
    "COOKIE_DOMAIN": "xiaoniaoshuo.com",
    "GOOGLE_MODEL": "gemini-3-pro-preview",
    "GOOGLE_IMAGE_MODEL": "gemini-2.5-flash-image",
    "GOOGLE_TTS_MODEL": "gemini-2.5-flash-preview-tts",
    "DEFAULT_TTS_VOICE": "Aoede",
    "GOOGLE_VIDEO_MODEL": "veo-3.1-fast-generate-preview",
    "OPENAI_TTS_MODEL": "gpt-4o-mini-tts",
    "OPENAI_VIDEO_MODEL": "sora-2",
    "NEXT_PUBLIC_HEADLESS_MODE": "true",
    "NEXT_PUBLIC_GA_ID": "G-7GQKFPXHD1",
    "NEXT_PUBLIC_SITE_URL": "https://cms.xiaoniaoshuo.com",
    "NEXT_PUBLIC_SITE_NAME": "小鸟说",
    "ROOT_USER_EMAIL": "meathill@gmail.com",
    "RPC_PROVIDER_URL": "https://aeneid.storyrpc.io",
    "TRUSTED_ORIGINS": "https://xiaoniaoshuo.com"
  }
}
