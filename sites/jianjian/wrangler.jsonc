{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "xiaoniaoshuo",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "9bf5ab2aa257483f9d82800297591bb8",
      "preview_id": "9bf5ab2aa257483f9d82800297591bb8"
    }
  ],
  // observability 已关闭：Workers Logs 额度不足，打开 persist/head 采样会持续烧额度。
  // 需要排障时再临时打开，平时保持关闭。
  "observability": {
    "enabled": false
  },
  "placement": {
    "mode": "smart"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "site-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "xiaoniaoshuo"
    },
    {
      "binding": "MAIN_APP",
      "service": "mui-gamebook"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://cms.xiaoniaoshuo.com",
    "NEXT_PUBLIC_SITE_URL": "https://xiaoniaoshuo.com",
    "NEXT_PUBLIC_SITE_NAME": "小鸟说"
  }
}
